.DS_Store

# .claude/ is tracked project knowledge (settings, plans, skills) — only
# volatile machine-local state stays out.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Generated build artifacts — NOT tracked on master.
# The source of truth is src/*.scad (cookie cutters) and the bikar-repo
# patterns/Orbs/*.bkr (orbs); `make cookie-cutters` / `make orbs` +
# `make web-images` regenerate build/, and `make deploy` publishes it to the
# gh-pages branch (which keeps its own committed copy that GitHub Pages
# serves). The build/*.py helpers are source, not artifacts — keep tracked.
build/*
!build/*.py

# Studio pages vendored from bikar's packages/lab by `make lab` / `make lego-lab`
# — generated, published to gh-pages by `make deploy`, never tracked on master.
# One vite build emits all of them, so they share the hashed assets/ dir.
/studio.html
/lab.html
/lego.html
/design.html
/breakdown.html
/assets/

# gh-pages deploy worktree (created by `make deploy`)
.gh-pages/

# Python bytecode (skills/*/validate.py and friends)
__pycache__/
*.pyc
