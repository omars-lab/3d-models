@@ -0,0 +1,479 @@
+/**
+ * The coaster window: a square sample cut out of a full coaster at that
+ * coaster's own scale, for the sampler sheets (3d-models
+ * `docs/design/coaster/sampler-sheets-design.md`).
+ *
+ * WHY a cut in the kernel's frame rather than a smaller coaster: the art is
+ * placed and sized for the full coaster before the window applies, so the
+ * window keeps the coaster's mm-per-unit. Shrinking the coaster (`size=30`)
+ * re-fits the whole pattern into 30 mm and every strap shrinks with it — the
+ * one thing a sample must not do.
+ *
+ * The window is one more term in the coaster's signed solid value
+ * ({@link windowValueAt}): positive inside the square, negative outside, and a
+ * straight line across every grid edge it crosses, so the marching-squares
+ * walls land exactly on the window's edge — a flat cut, not a staircase. Top
+ * heights are not touched, so a cut strap ends flat at its full height.
+ *
+ * This module imports nothing from `coaster.ts` (which imports it): the types
+ * below are the few fields it reads, kept structural so no import cycle forms.
+ */
+
+import type { Point } from '../primitives/types.js';
+
+/** A square window: side `sideMm`, centred at `centre` in the full coaster's frame (mm, art centre at the origin). */
+export interface CoasterWindow {
+  readonly centre: Point;
+  readonly sideMm: number;
+}
+
+/** A piece the window cut off from the main body and the kernel dropped. */
+export interface DroppedWindowPiece {
+  /** Approximate footprint area in mm² (solid grid points × pitch²). */
+  readonly areaMm2: number;
+  /** One grid point of the piece, in mm, so a report can say where it was. */
+  readonly at: Point;
+}
+
+/**
+ * The window's signed value at `p`, in mm: half the side minus the Chebyshev
+ * distance to the centre — positive inside, zero on the edge, negative outside.
+ * `+Infinity` without a window, so the coaster's `min` of terms is unchanged and
+ * a coaster without a window is byte-identical to one built before windows.
+ *
+ * @example
+ * windowValueAt({ x: 0, y: 0 }, { centre: { x: 0, y: 0 }, sideMm: 30 }) // 15
+ */
+export function windowValueAt(p: Point, window: CoasterWindow | undefined): number {
+  if (window === undefined) return Infinity;
+  const dx = Math.abs(p.x - window.centre.x);
+  const dy = Math.abs(p.y - window.centre.y);
+  return window.sideMm / 2 - Math.max(dx, dy);
+}
+
+/**
+ * The point of the window nearest `p` (`p` itself inside it, or without a
+ * window). WHY: a cut wall's top takes the height of the grid point just
+ * outside the window, so that point is sampled where the cut stands — on the
+ * window's edge — and the cut face shows the coaster's own section there
+ * instead of whatever lies a cell beyond it (a hole would notch the face).
+ *
+ * @example
+ * clampToWindow({ x: 20, y: 0 }, { centre: { x: 0, y: 0 }, sideMm: 30 }) // { x: 15, y: 0 }
+ */
+export function clampToWindow(p: Point, window: CoasterWindow | undefined): Point {
+  if (window === undefined) return p;
+  const h = window.sideMm / 2;
+  const { x: cx, y: cy } = window.centre;
+  const x = Math.min(cx + h, Math.max(cx - h, p.x));
+  const y = Math.min(cy + h, Math.max(cy - h, p.y));
+  return x === p.x && y === p.y ? p : { x, y };
+}
+
+/** The spec fields a window can clash with — structural, so this module need not import `CoasterSpec`. */
+export interface WindowConflictSpec {
+  readonly window?: CoasterWindow;
+  readonly interlock?: unknown;
+  readonly key?: unknown;
+  readonly tab?: unknown;
+  readonly twistDeg?: number;
+  readonly loose?: unknown;
+  readonly edges?: readonly { readonly side: 'top' | 'bottom' }[];
+}
+
+/**
+ * Refuse a window the kernel cannot cut honestly, by name. A join (interlock,
+ * key, tab) exists to mate with a neighbouring coaster, which a sample has none
+ * of; a twist lofts the footprint into a helix the flat cut does not follow;
+ * a bottom edge insets the traced outline, which would chamfer the cut faces
+ * too, so the sample's sides would not be the coaster's; and loose pieces mesh
+ * their pockets and pieces apart from the traced top, which the cut does not
+ * reach, so a window would slice the frame and leave the pieces whole.
+ */
+export function refuseWindowConflicts(spec: WindowConflictSpec): void {
+  const w = spec.window;
+  if (w === undefined) return;
+  if (!(Number.isFinite(w.sideMm) && w.sideMm > 0)) {
+    throw new Error(`coaster: window side must be a positive number of mm, got ${w.sideMm}.`);
+  }
+  if (!(Number.isFinite(w.centre.x) && Number.isFinite(w.centre.y))) {
+    throw new Error('coaster: window centre must be two finite numbers (mm).');
+  }
+  const clash = windowClash(spec);
+  if (clash !== undefined) {
+    throw new Error(
+      `coaster: a window cannot be cut from a coaster with ${clash} — ` +
+        'render the full coaster, or sample one without it.',
+    );
+  }
+}
+
+/** The first clause that cannot stand beside a window, named as the author wrote it. */
+function windowClash(spec: WindowConflictSpec): string | undefined {
+  if (spec.interlock !== undefined) return "an 'interlock' join";
+  if (spec.key !== undefined) return "a 'key' join";
+  if (spec.tab !== undefined) return "a 'tab' join";
+  if (spec.twistDeg !== undefined && spec.twistDeg > 0) return "a 'twist'";
+  if (spec.edges?.some((e) => e.side === 'bottom')) return 'a bottom edge';
+  if (spec.loose !== undefined) return "a 'loose' clause";
+  return undefined;
+}
+
+/**
+ * Cut the sampled field down to its window's one printable body: drop the
+ * pieces the cut detached ({@link dropWindowIslands}), then refuse, by edge,
+ * any cut that shaves a strap lengthwise into a fin thinner than `floorMm`
+ * ({@link windowSlivers}). A fin is a thin stretch longer than two floors: on
+ * the three sampler coasters a strap cut across, or a hole's corner touching
+ * the edge, leaves thin stretches of at most 2.8 mm, and a strap the edge runs
+ * along leaves 5.6 mm or more (a 0.25 mm sweep of the CS-2 centre), so the line
+ * sits in the gap between them. Returns what was dropped.
+ */
+export function cutWindow(
+  field: WindowField,
+  window: CoasterWindow,
+  floorMm: number,
+): DroppedWindowPiece[] {
+  const dropped = dropWindowIslands(field);
+  const fins = windowSlivers(field, window, floorMm, 2 * floorMm);
+  if (fins.length > 0) {
+    const f = fins[0];
+    const along = f.edge === 'left' || f.edge === 'right' ? 'y' : 'x';
+    throw new Error(
+      `coaster: the window's ${f.edge} edge runs along a strap and leaves a fin ` +
+        `${f.depthMm.toFixed(2)} mm thin for ${f.lengthMm.toFixed(1)} mm from ${along} = ` +
+        `${f.fromMm.toFixed(1)}, under the ${floorMm} mm free-standing floor` +
+        `${fins.length > 1 ? ` (and ${fins.length - 1} more)` : ''}. Move the window so that ` +
+        'edge crosses the strap or clears it — a strap width either way is enough.',
+    );
+  }
+  return dropped;
+}
+
+/** The field arrays the island pass reads and clears — the subset of `CoasterField` it touches. */
+export interface WindowField {
+  readonly pitchMm: number;
+  readonly nx: number;
+  readonly ny: number;
+  readonly x0: number;
+  readonly y0: number;
+  readonly solidV: Float64Array;
+  readonly inside: Uint8Array;
+  readonly solid: Uint8Array;
+  readonly relief: Uint8Array;
+  readonly deboss: Uint8Array;
+  readonly cut: Uint8Array;
+  readonly colorIndex: Int16Array;
+}
+
+/**
+ * Keep the window's largest piece and drop every other one, returning what was
+ * dropped. A window cuts straps wherever it crosses them, and a strap end near
+ * a corner can come away from the rest — a loose island that would print as a
+ * separate crumb. Dropping it (rather than refusing, or adding a frame that is
+ * not part of the coaster) keeps the sample exactly the coaster's art inside
+ * the square, minus what could not stay attached.
+ *
+ * Pieces are found the way the mesh joins them: grid points whose solid value
+ * is positive, linked along a grid edge, and across a cell's diagonal only when
+ * that cell is a saddle with a solid centre (the one case the trace joins two
+ * diagonal corners). A dropped point's value is negated, so the trace emits
+ * nothing there; a cell with no kept corner is cleared, so the validators
+ * (CV6b's one-body check above all) read the same single body the mesh has.
+ *
+ * Throws, by name, when the window holds none of the coaster.
+ */
+export function dropWindowIslands(field: WindowField): DroppedWindowPiece[] {
+  const label = labelSolidPoints(field);
+  const sizes = componentSizes(label);
+  if (sizes.length === 0) {
+    throw new Error('coaster: the window holds none of the coaster — move it onto the art.');
+  }
+  let keep = 0;
+  for (let c = 1; c < sizes.length; c++) if (sizes[c] > sizes[keep]) keep = c;
+  const dropped = describeDropped(field, label, sizes, keep);
+  for (let v = 0; v < label.length; v++) {
+    if (label[v] >= 0 && label[v] !== keep) field.solidV[v] = -field.solidV[v];
+  }
+  clearCellsWithoutKeptCorner(field, label, keep);
+  return dropped;
+}
+
+/** Each grid point's piece number (`-1` where open), pieces numbered from 0 in scan order. */
+function labelSolidPoints(field: WindowField): Int32Array {
+  const stride = field.nx + 1;
+  const label = new Int32Array(stride * (field.ny + 1)).fill(-1);
+  let next = 0;
+  for (let v = 0; v < label.length; v++) {
+    if (label[v] !== -1 || !(field.solidV[v] > 0)) continue;
+    floodFrom(field, label, v, next++);
+  }
+  return label;
+}
+
+/** Flood piece `id` out from grid point `start` over the mesh's links ({@link dropWindowIslands}). */
+function floodFrom(field: WindowField, label: Int32Array, start: number, id: number): void {
+  const stack = [start];
+  label[start] = id;
+  while (stack.length > 0) {
+    const v = stack.pop() as number;
+    for (const n of linkedPoints(field, v)) {
+      if (label[n] !== -1 || !(field.solidV[n] > 0)) continue;
+      label[n] = id;
+      stack.push(n);
+    }
+  }
+}
+
+/** The grid points the mesh can join to point `v`: its four edge neighbours and any solid-centre saddle diagonal. */
+function linkedPoints(field: WindowField, v: number): number[] {
+  const stride = field.nx + 1;
+  const i = v % stride;
+  const j = Math.floor(v / stride);
+  const out: number[] = [];
+  if (i > 0) out.push(v - 1);
+  if (i < field.nx) out.push(v + 1);
+  if (j > 0) out.push(v - stride);
+  if (j < field.ny) out.push(v + stride);
+  for (const [di, dj] of DIAGONALS) {
+    const d = saddleDiagonal(field, i, j, di, dj);
+    if (d >= 0) out.push(d);
+  }
+  return out;
+}
+
+const DIAGONALS: readonly (readonly [number, number])[] = [
+  [1, 1],
+  [1, -1],
+  [-1, 1],
+  [-1, -1],
+];
+
+/**
+ * The diagonal neighbour of point `(i, j)` in direction `(di, dj)` when the cell
+ * between them is a solid-centre saddle (both other corners open), else `-1`.
+ */
+function saddleDiagonal(field: WindowField, i: number, j: number, di: number, dj: number): number {
+  const ci = di > 0 ? i : i - 1;
+  const cj = dj > 0 ? j : j - 1;
+  if (ci < 0 || cj < 0 || ci >= field.nx || cj >= field.ny) return -1;
+  if (field.solid[cj * field.nx + ci] !== 1) return -1;
+  const stride = field.nx + 1;
+  const sideA = j * stride + (i + di);
+  const sideB = (j + dj) * stride + i;
+  if (field.solidV[sideA] > 0 || field.solidV[sideB] > 0) return -1;
+  return (j + dj) * stride + (i + di);
+}
+
+/** How many grid points each piece holds. */
+function componentSizes(label: Int32Array): number[] {
+  const sizes: number[] = [];
+  for (const id of label) {
+    if (id < 0) continue;
+    while (sizes.length <= id) sizes.push(0);
+    sizes[id]++;
+  }
+  return sizes;
+}
+
+/** The dropped pieces, largest first, each with its area and one point of it. */
+function describeDropped(
+  field: WindowField,
+  label: Int32Array,
+  sizes: readonly number[],
+  keep: number,
+): DroppedWindowPiece[] {
+  const stride = field.nx + 1;
+  const at = new Map<number, Point>();
+  for (let v = 0; v < label.length; v++) {
+    const id = label[v];
+    if (id < 0 || id === keep || at.has(id)) continue;
+    const i = v % stride;
+    const j = Math.floor(v / stride);
+    at.set(id, { x: field.x0 + i * field.pitchMm, y: field.y0 + j * field.pitchMm });
+  }
+  const area = field.pitchMm * field.pitchMm;
+  return [...at.entries()]
+    .map(([id, p]) => ({ areaMm2: sizes[id] * area, at: p }))
+    .sort((a, b) => b.areaMm2 - a.areaMm2);
+}
+
+/**
+ * Clear the flags of every cell that held only dropped solid: no corner in the
+ * kept piece, and either a dropped corner or a solid centre with no solid
+ * corner at all (a sliver the trace emits nothing for). A cell that was open
+ * throughout — a trivet hole, the space between straps — is left as sampled.
+ */
+function clearCellsWithoutKeptCorner(field: WindowField, label: Int32Array, keep: number): void {
+  const stride = field.nx + 1;
+  for (let j = 0; j < field.ny; j++) {
+    for (let i = 0; i < field.nx; i++) {
+      const v0 = j * stride + i;
+      const corners = [v0, v0 + 1, v0 + stride, v0 + stride + 1];
+      if (corners.some((v) => label[v] === keep)) continue;
+      const idx = j * field.nx + i;
+      if (field.solid[idx] !== 1 && !corners.some((v) => label[v] >= 0)) continue;
+      field.inside[idx] = 0;
+      field.solid[idx] = 0;
+      field.relief[idx] = 0;
+      field.deboss[idx] = 0;
+      field.cut[idx] = 0;
+      field.colorIndex[idx] = -1;
+    }
+  }
+}
+
+/** A stretch along one window edge where the cut leaves solid thinner than the floor. */
+export interface WindowSliver {
+  /** Which edge of the window, as seen from above with `+y` up. */
+  readonly edge: 'left' | 'right' | 'bottom' | 'top';
+  /** How far the stretch runs along the edge, in mm. */
+  readonly lengthMm: number;
+  /** The thinnest solid behind the edge along the stretch, in mm. */
+  readonly depthMm: number;
+  /** Where the stretch starts along the edge (its `y` for left/right, `x` for bottom/top), in mm. */
+  readonly fromMm: number;
+}
+
+/** One window edge as a walk: the axis the walk runs along, its sign, and where the edge stands. */
+interface EdgeWalk {
+  readonly edge: WindowSliver['edge'];
+  /** 0 = walk along x (left/right edges), 1 = walk along y (bottom/top edges). */
+  readonly axis: 0 | 1;
+  /** +1 walks toward +axis from the edge, -1 toward -axis. */
+  readonly sign: 1 | -1;
+  /** The edge's coordinate on the walk axis. */
+  readonly at: number;
+}
+
+/** The four edges of `window`, each with the inward direction a walk takes. */
+function edgeWalks(window: CoasterWindow): EdgeWalk[] {
+  const h = window.sideMm / 2;
+  const { x, y } = window.centre;
+  return [
+    { edge: 'left', axis: 0, sign: 1, at: x - h },
+    { edge: 'right', axis: 0, sign: -1, at: x + h },
+    { edge: 'bottom', axis: 1, sign: 1, at: y - h },
+    { edge: 'top', axis: 1, sign: -1, at: y + h },
+  ];
+}
+
+/** Grid geometry the sliver walk reads — a subset of `CoasterField`. */
+type SliverField = Pick<WindowField, 'pitchMm' | 'nx' | 'ny' | 'x0' | 'y0' | 'solidV'>;
+
+/**
+ * Every stretch along a window edge where the cut leaves solid thinner than
+ * `floorMm` for longer than `maxRunMm` — the thin fin a cut makes when it runs
+ * along a strap instead of across it. WHY: a strap that ends at the window is
