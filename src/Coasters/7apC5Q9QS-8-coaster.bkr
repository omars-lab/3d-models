  circle d center(C) through D
  # ────────────────────────────────────────────────────────
  # t=07:50  E = Intersect(d, k, 1)
  point E = intersect d k pick 1
  # ────────────────────────────────────────────────────────
  # t=08:24  p = Line(E, g)
