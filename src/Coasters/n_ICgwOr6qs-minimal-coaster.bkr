pattern n_ICgwOr6qs on n_ICgwOr6qs_scaffold
  # ────────────────────────────────────────────────────────
  # fa1 = CircularArc(D144, i0, t108)
  connect arc i0 -> t108 on fa1_host
  # ────────────────────────────────────────────────────────
  # t=05:58  fa2 = CircularArc(D144, t180, i288)
  connect arc t180 -> i288 on fa2_host
  # ────────────────────────────────────────────────────────
  # t=06:20  f2 = Rotate({fa1, fa2}, 72°, O)
  connect arc i0_f2 -> t108_f2 on fa1_host_f2
  # t=06:20  f2 = Rotate({fa1, fa2}, 72°, O)
  connect arc t180_f2 -> i288_f2 on fa2_host_f2
  # ────────────────────────────────────────────────────────
  # t=06:46  f3 = Rotate({fa1, fa2}, 144°, O)
  connect arc i0_f3 -> t108_f3 on fa1_host_f3
  # t=06:46  f3 = Rotate({fa1, fa2}, 144°, O)
  connect arc t180_f3 -> i288_f3 on fa2_host_f3
  # ────────────────────────────────────────────────────────
  # t=07:06  f4 = Rotate({fa1, fa2}, 216°, O)
  connect arc i0_f4 -> t108_f4 on fa1_host_f4
  # t=07:06  f4 = Rotate({fa1, fa2}, 216°, O)
