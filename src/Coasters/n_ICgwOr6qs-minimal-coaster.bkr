  # ────────────────────────────────────────────────────────
  # t=07:15  f5 = Rotate({fa1, fa2}, 288°, O)
  connect arc i0_f5 -> t108_f5 on fa1_host_f5
  # t=07:15  f5 = Rotate({fa1, fa2}, 288°, O)
  connect arc t180_f5 -> i288_f5 on fa2_host_f5
  # ────────────────────────────────────────────────────────
  # ba1 = CircularArc(D252, t288, X306)
  connect arc t288 -> X306 on ba1_host
  # ────────────────────────────────────────────────────────
  # t=07:40  ba2 = CircularArc(D252, X198, t216)
  connect arc X198 -> t216 on ba2_host
  # ────────────────────────────────────────────────────────
  # t=07:48  b2 = Rotate({ba1, ba2}, 72°, O)
  connect arc t288_b2 -> X306_b2 on ba1_host_b2
  # t=07:48  b2 = Rotate({ba1, ba2}, 72°, O)
  connect arc X198_b2 -> t216_b2 on ba2_host_b2
  # ────────────────────────────────────────────────────────
