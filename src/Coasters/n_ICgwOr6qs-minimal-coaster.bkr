  # b3 = Rotate({ba1, ba2}, 144°, O)
  circle ba2_host_b3 = rotate ba2_host by 144 around O
  # ────────────────────────────────────────────────────────
  # t=07:55  b4 = Rotate({ba1, ba2}, 216°, O)
  point t288_b4 = rotate t288 by 216 around O
  # t=07:55  b4 = Rotate({ba1, ba2}, 216°, O)
  point X306_b4 = rotate X306 by 216 around O
  # t=07:55  b4 = Rotate({ba1, ba2}, 216°, O)
  circle ba1_host_b4 = rotate ba1_host by 216 around O
  # t=07:55  b4 = Rotate({ba1, ba2}, 216°, O)
  point X198_b4 = rotate X198 by 216 around O
  # t=07:55  b4 = Rotate({ba1, ba2}, 216°, O)
  point t216_b4 = rotate t216 by 216 around O
  # t=07:55  b4 = Rotate({ba1, ba2}, 216°, O)
  circle ba2_host_b4 = rotate ba2_host by 216 around O
  # ────────────────────────────────────────────────────────
  # t=08:00  b5 = Rotate({ba1, ba2}, 288°, O)
  point t288_b5 = rotate t288 by 288 around O
  # t=08:00  b5 = Rotate({ba1, ba2}, 288°, O)
  point X306_b5 = rotate X306 by 288 around O
  # t=08:00  b5 = Rotate({ba1, ba2}, 288°, O)
  circle ba1_host_b5 = rotate ba1_host by 288 around O
  # t=08:00  b5 = Rotate({ba1, ba2}, 288°, O)
  point X198_b5 = rotate X198 by 288 around O
  # t=08:00  b5 = Rotate({ba1, ba2}, 288°, O)
  point t216_b5 = rotate t216 by 288 around O
  # t=08:00  b5 = Rotate({ba1, ba2}, 288°, O)
