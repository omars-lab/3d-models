  # t=07:55  b4 = Rotate({ba1, ba2}, 216°, O)
  connect arc X198_b4 -> t216_b4 on ba2_host_b4
  # ────────────────────────────────────────────────────────
  # t=08:00  b5 = Rotate({ba1, ba2}, 288°, O)
  connect arc t288_b5 -> X306_b5 on ba1_host_b5
  # t=08:00  b5 = Rotate({ba1, ba2}, 288°, O)
  connect arc X198_b5 -> t216_b5 on ba2_host_b5

coaster Coaster
  outline pattern
  inscribe n_ICgwOr6qs
  base $height
  strap width $strap
  edge fillet $round top
  holes round $tip weld $weld
