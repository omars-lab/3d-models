  polygon Q9_R4_R5 = reflect Q9_R4 across h1
  # t=16:20  R5 = Reflect(R4, h1)
  point E1_R2_R4_R5 = reflect E1_R2_R4 across h1
  # t=16:20  R5 = Reflect(R4, h1)
  polygon Q1_R2_R4_R5 = reflect Q1_R2_R4 across h1
  # t=16:20  R5 = Reflect(R4, h1)
  polygon Q2_R2_R4_R5 = reflect Q2_R2_R4 across h1
  # t=16:20  R5 = Reflect(R4, h1)
  polygon Q3_R2_R4_R5 = reflect Q3_R2_R4 across h1

pattern bknVRSMcLj0 on bknVRSMcLj0_scaffold
  # ────────────────────────────────────────────────────────
  # t=13:32  R1 = Sequence(Rotate({Q1, Q2, Q3}, pi*i/3, E1), i, 0, 5)
  rotate 6 around E1
    edges from Q1
    edges from Q2
    edges from Q3
  # ────────────────────────────────────────────────────────
  # t=14:45  R3 = Sequence(Rotate({Q4, Q5, Q6, Q7, Q8, Q9, R2}, pi*i/2, E1), i, 0, 3)
  rotate 4 around E1
    edges from Q4
    edges from Q5
    edges from Q6
    edges from Q7
    edges from Q8
    edges from Q9
    rotate 6 around E1_R2
      edges from Q1_R2
      edges from Q2_R2
      edges from Q3_R2
  # ────────────────────────────────────────────────────────
  # t=17:41  R6 = Sequence(Rotate({R4, R5}, pi*i/2, E1), i, 0, 3)
  rotate 4 around E1
    rotate 6 around E1_R4
      edges from Q1_R4
      edges from Q2_R4
      edges from Q3_R4
    rotate 4 around E1_R42
      edges from Q4_R4
      edges from Q5_R4
      edges from Q6_R4
      edges from Q7_R4
      edges from Q8_R4
      edges from Q9_R4
      rotate 6 around E1_R2_R4
        edges from Q1_R2_R4
        edges from Q2_R2_R4
        edges from Q3_R2_R4
    rotate 6 around E1_R4_R5
      edges from Q1_R4_R5
      edges from Q2_R4_R5
      edges from Q3_R4_R5
    rotate 4 around E1_R42_R5
      edges from Q4_R4_R5
      edges from Q5_R4_R5
      edges from Q6_R4_R5
      edges from Q7_R4_R5
      edges from Q8_R4_R5
      edges from Q9_R4_R5
      rotate 6 around E1_R2_R4_R5
        edges from Q1_R2_R4_R5
        edges from Q2_R2_R4_R5
        edges from Q3_R2_R4_R5
  palette pal
    Slab = #333333
    Gold = #d4af37

coaster Coaster
  outline square $size
  inscribe bknVRSMcLj0
  base $height
  relief straps emboss 1.2
  strap width 2
  color base Slab
  color straps Gold
