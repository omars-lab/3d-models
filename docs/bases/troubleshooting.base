filters:
  and:
    - file.ext == "md"
    - file.inFolder("wiki/troubleshooting")
properties:
  note.title:
    displayName: Title
  note.symptom:
    displayName: Symptom
  note.kind:
    displayName: Kind
  note.proof:
    displayName: Proof
  note.first_seen:
    displayName: First seen
views:
  - type: table
    name: By kind
    groupBy:
      property: kind
      direction: ASC
    order:
      - title
      - symptom
      - proof
      - first_seen
    sort:
      - property: note.first_seen
        direction: DESC
