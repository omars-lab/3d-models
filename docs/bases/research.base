filters:
  and:
    - file.ext == "md"
    - file.inFolder("research")
formulas:
  linked_from: file.backlinks.length
properties:
  note.date:
    displayName: Date
  note.feeds:
    displayName: Feeds
  formula.linked_from:
    displayName: Linked from
views:
  - type: table
    name: Newest first
    order:
      - file.name
      - date
      - feeds
      - formula.linked_from
    sort:
      - property: note.date
        direction: DESC
  - type: table
    name: Feeds nothing
    filters:
      or:
        - '!file.hasProperty("feeds")'
        - note.feeds.length == 0
    order:
      - file.name
      - date
