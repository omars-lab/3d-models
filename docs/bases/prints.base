filters:
  and:
    - file.ext == "md"
    - file.inFolder("prints")
    - file.hasProperty("run")
properties:
  note.run:
    displayName: Run
  note.plate:
    displayName: Plate
  note.status:
    displayName: Status
  note.outcome:
    displayName: Outcome
views:
  - type: table
    name: Newest first
    order:
      - run
      - plate
      - status
      - outcome
    sort:
      - property: note.run
        direction: DESC
