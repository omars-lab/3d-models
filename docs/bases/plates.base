filters:
  and:
    - file.ext == "md"
    - file.inFolder("design/plates")
    - file.hasProperty("stage")
properties:
  note.stage:
    displayName: Stage
  note.times_printed:
    displayName: Times printed
  note.maturity:
    displayName: Maturity
  note.risk:
    displayName: Risk
  note.answers:
    displayName: What it answers
views:
  - type: table
    name: By stage
    groupBy:
      property: stage
      direction: ASC
    order:
      - file.name
      - stage
      - times_printed
      - maturity
      - risk
      - answers
    sort:
      - property: file.name
        direction: ASC
