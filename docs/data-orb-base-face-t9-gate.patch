+def _base_faces(svg: str) -> tuple[set[int], set[int], int]:
+    """(faces the scaffold outlines, faces the drawn cells claim, scaffold ring count).
+
+    The scaffold rings are returned even when unlabelled so T9 can tell a stale
+    dist that draws outlines without stamping them from an honest empty frame.
+    """
+    scaffold: set[int] = set()
+    drawn: set[int] = set()
+    scaffold_rings = 0
+    for attrs in PATH_RE.findall(svg):
+        label = BASE_FACE_RE.search(attrs)
+        if "data-orb-scaffold" in attrs:
+            scaffold_rings += 1
+            if label:
+                scaffold.add(int(label.group(1)))
+        elif label:
+            fill = FILL_RE.search(attrs)
+            if fill and fill.group(1).lower() not in ("none", "#ffffff"):
+                drawn.add(int(label.group(1)))
+    return scaffold, drawn, scaffold_rings
+
