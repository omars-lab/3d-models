#!/bin/sh
# Design-doc gate (.claude/gates/docs_gate.py). Blocks a commit whose staged
# markdown carries a dead relative link (D1/K9), a validator with no asserted
# PASS+FAIL example (D2/K6), or a default with no citation or CAL-* bet id
# (D3/K4). Rules and evidence: docs/grounding-defect-taxonomy.md.
# Override once: DOCS_GATE_OK=1 git commit
#
# The wholesale form drops --staged and adds the gate's own --self-test.
# wholesale: make validate-docs
[ -n "$DOCS_GATE_OK" ] && exit 0
if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: python3 not found — needed for the design-doc gate" >&2
  exit 1
fi
# Same worktree caveat as 20-use-cases: `gh-pages` carries `.githooks` and not
# `.claude`, and its commits are built site output with no design doc in them.
GATE="$(git rev-parse --show-toplevel)/.claude/gates/docs_gate.py"
if [ ! -f "$GATE" ]; then
  echo "pre-commit: no docs gate in this worktree ($GATE) — skipping" >&2
  exit 0
fi
exec python3 "$GATE" --staged
