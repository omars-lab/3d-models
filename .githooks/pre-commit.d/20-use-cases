#!/bin/sh
# Use-case map guard (skill: .claude/skills/maintain-use-cases/). Blocks
# commits that change pointer-referenced files without updating the map,
# enforces as_of == HEAD when the map itself is staged, and reminds on
# experience-surface edits. Override the block once: USE_CASES_OK=1 git commit
#
# When the map IS staged the validator runs in full, which since 2026-08-02
# includes the anchor rule: a pointer written `path:L137 "orbs:"` must have
# that literal inside the lines it names. That is the check the block above was
# standing in for and could not make — it knew the commit touched a pointed-at
# file, never whether the pointer still pointed at the right thing. 23 of 44
# line claims had drifted by the day it was added.
#
# The wholesale form drops --staged and validates every pointer in the map.
# wholesale: make validate-use-cases
#
# Since 2026-08-03 a self-repo pointer is read from what this commit will
# contain — the index for a staged file, HEAD for the rest — never from the pin.
# `--refresh` runs before the commit exists, so it pins the parent; reading there
# re-verified anchors against the content the commit was about to replace, and
# the guard proved only that the map had been refreshed. Sibling repos are still
# pinned: they move with no commit here to blame. `validate.py --self-test`.
if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: python3 not found — needed for use-case validation" >&2
  exit 1
fi
python3 -c "import yaml" 2>/dev/null || { echo "pre-commit: PyYAML required for use-case validation: pip install pyyaml" >&2; exit 1; }

# `core.hooksPath` is repo-wide, so this runs in every worktree — including the
# `gh-pages` one `make deploy` creates, a deliberately diverged branch that
# carries `.githooks` but not `.claude`. There is no map there to guard and no
# pointer file to break, so skip rather than fail the deploy. Announced, not
# silent: if this ever prints in the master worktree, the guard is off and the
# reason is that the validator went missing.
VALIDATE="$(git rev-parse --show-toplevel)/.claude/skills/maintain-use-cases/validate.py"
if [ ! -f "$VALIDATE" ]; then
  echo "pre-commit: no use-case map in this worktree ($VALIDATE) — skipping the guard" >&2
  exit 0
fi
exec python3 "$VALIDATE" --staged
