#!/bin/sh
# Pre-commit secret scan. Activate on a fresh clone with: make setup-hooks
# (sets core.hooksPath to .githooks). Fails closed: no gitleaks, no commit.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed — brew install gitleaks" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
