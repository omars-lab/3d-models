#!/bin/sh
# Pre-commit dispatcher: runs every executable in .githooks/pre-commit.d/
# in lexical order; the first failure aborts the commit.
# Activate on a fresh clone with: make setup-hooks
#
# This used to enumerate three of the hooks. It stayed at three while the
# directory grew to eight, which is the ordinary fate of a list kept beside the
# thing it lists — so read the directory instead. Each hook's own header says
# what it does, and its `# wholesale:` line says how to run it over the whole
# tree; `make validate` runs all of them that way, and .claude/gates/
# hook_parity.py fails a hook that declares neither.
hookdir="$(dirname "$0")/pre-commit.d"
for hook in "$hookdir"/*; do
  [ -x "$hook" ] || continue
  "$hook" || exit $?
done
